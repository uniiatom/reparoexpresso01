# Copie para .env local ou cadastre no Netlify:
# Site settings → Environment variables → Add variable
# (todas precisam do prefixo VITE_ para o Vite expor no build)

# --- Supabase (obrigatório) ---
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_chave_publishable_anon

# Bucket de uploads (opcional; padrão: uploads)
# VITE_SUPABASE_STORAGE_BUCKET=uploads

# --- Legado Base44 (opcional; só se ainda usar app-params) ---
# VITE_BASE44_APP_ID=
# VITE_BASE44_APP_BASE_URL=
# VITE_BASE44_FUNCTIONS_VERSION=

# --- Push no celular (opcional) ---
# VITE_VAPID_PUBLIC_KEY=

# Após o deploy no Netlify, configure no Supabase → Authentication → URL Configuration:
# - Site URL: https://SEU-SITE.netlify.app
# - Redirect URLs: https://SEU-SITE.netlify.app/**
