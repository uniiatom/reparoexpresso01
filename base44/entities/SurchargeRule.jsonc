{
  "name": "SurchargeRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da regra (ex: Noturno, Domingo, Feriado)"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "time_range",
        "day_of_week",
        "holiday"
      ],
      "description": "Tipo de regra: faixa de hor\u00e1rio, dia da semana, ou feriado"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "Dias da semana (0=Dom, 1=Seg, ..., 6=S\u00e1b). Usado quando rule_type=day_of_week ou time_range com dias espec\u00edficos"
    },
    "time_start": {
      "type": "string",
      "description": "Hora de in\u00edcio no formato HH:MM (ex: 22:00)"
    },
    "time_end": {
      "type": "string",
      "description": "Hora de fim no formato HH:MM (ex: 06:00). Se menor que time_start, entende-se que passa da meia-noite"
    },
    "surcharge_percent": {
      "type": "number",
      "description": "Percentual de sobretaxa a aplicar (ex: 30 para 30%)"
    },
    "applies_to_all_services": {
      "type": "boolean",
      "default": true,
      "description": "Se aplica a todos os servi\u00e7os"
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de servi\u00e7o espec\u00edficos (se applies_to_all_services=false)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a regra est\u00e1 ativa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/observa\u00e7\u00e3o da regra"
    }
  },
  "required": [
    "name",
    "rule_type",
    "surcharge_percent"
  ]
}