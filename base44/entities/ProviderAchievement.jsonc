{
  "name": "ProviderAchievement",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "provider_name": {
      "type": "string",
      "description": "Nome do prestador (desnormalizado)"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "N\u00edvel atual do prestador (1-5)"
    },
    "total_jobs_completed": {
      "type": "number",
      "default": 0,
      "description": "Total de servi\u00e7os conclu\u00eddos"
    },
    "average_rating": {
      "type": "number",
      "default": 5,
      "description": "Avalia\u00e7\u00e3o m\u00e9dia recebida"
    },
    "achievements_unlocked": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das conquistas desbloqueadas"
    },
    "visibility_bonus_percent": {
      "type": "number",
      "default": 0,
      "description": "B\u00f4nus de visibilidade por n\u00edvel (%)"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Se est\u00e1 em destaque (apenas n\u00edvel 5)"
    },
    "level_up_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo aumento de n\u00edvel"
    }
  },
  "required": [
    "provider_id"
  ]
}