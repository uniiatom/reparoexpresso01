{
  "name": "MonthlyGoal",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia no formato YYYY-MM (ex: 2026-05)"
    },
    "min_jobs": {
      "type": "number",
      "description": "M\u00ednimo de servi\u00e7os conclu\u00eddos para qualificar"
    },
    "min_rating": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o m\u00e9dia m\u00ednima para qualificar (ex: 4.5)"
    },
    "min_punctuality": {
      "type": "number",
      "description": "Pontualidade m\u00ednima m\u00e9dia para qualificar (ex: 4.0)"
    },
    "bonus_1st": {
      "type": "number",
      "description": "Valor do b\u00f4nus para 1\u00ba colocado (R$)"
    },
    "bonus_2nd": {
      "type": "number",
      "description": "Valor do b\u00f4nus para 2\u00ba colocado (R$)"
    },
    "bonus_3rd": {
      "type": "number",
      "description": "Valor do b\u00f4nus para 3\u00ba colocado (R$)"
    },
    "bonus_released": {
      "type": "boolean",
      "default": false,
      "description": "Se os b\u00f4nus j\u00e1 foram liberados"
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de libera\u00e7\u00e3o dos b\u00f4nus"
    },
    "released_by": {
      "type": "string",
      "description": "Email do admin que liberou os b\u00f4nus"
    }
  },
  "required": [
    "month",
    "min_jobs",
    "min_rating",
    "bonus_1st"
  ]
}