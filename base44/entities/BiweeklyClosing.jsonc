{
  "name": "BiweeklyClosing",
  "type": "object",
  "properties": {
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "provider_name": {
      "type": "string",
      "description": "Nome do prestador"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "In\u00edcio do per\u00edodo (1 ou 16 do m\u00eas)"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Fim do per\u00edodo (15 ou \u00faltimo dia do m\u00eas)"
    },
    "period_label": {
      "type": "string",
      "description": "Ex: 01/04 a 15/04/2026"
    },
    "total_services": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de servi\u00e7os no per\u00edodo"
    },
    "gross_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor bruto dos servi\u00e7os"
    },
    "reserve_fund_deduction": {
      "type": "number",
      "default": 0,
      "description": "Valor retido para fundo de reserva (3%)"
    },
    "net_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido a receber"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente_nota",
        "nota_enviada",
        "pago"
      ],
      "default": "pendente_nota",
      "description": "pendente_nota = aguardando emiss\u00e3o da NF, nota_enviada = NF enviada, pago = repasse efetuado"
    },
    "invoice_id": {
      "type": "string",
      "description": "ID da nota fiscal vinculada"
    },
    "service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos servi\u00e7os inclu\u00eddos"
    },
    "payment_proof_url": {
      "type": "string",
      "description": "URL do comprovante de pagamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "provider_id",
    "period_start",
    "period_end",
    "net_amount"
  ]
}