{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "ID do dono da carteira"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "cliente",
        "prestador"
      ],
      "description": "Tipo do dono"
    },
    "owner_name": {
      "type": "string",
      "description": "Nome do dono (desnormalizado)"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do dono"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo dispon\u00edvel em R$"
    },
    "pending_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo pendente (aguardando libera\u00e7\u00e3o)"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total j\u00e1 ganho/creditado"
    },
    "total_withdrawn": {
      "type": "number",
      "default": 0,
      "description": "Total j\u00e1 sacado"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX do titular"
    },
    "pix_key_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj",
        "email",
        "telefone",
        "aleatoria"
      ],
      "description": "Tipo da chave PIX"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "owner_id",
    "owner_type"
  ]
}