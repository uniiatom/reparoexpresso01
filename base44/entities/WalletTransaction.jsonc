{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "wallet_id": {
      "type": "string",
      "description": "ID da carteira"
    },
    "owner_id": {
      "type": "string",
      "description": "ID do dono"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "cliente",
        "prestador"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "credit",
        "debit",
        "withdrawal",
        "refund",
        "cashback",
        "bonus"
      ],
      "description": "Tipo da transa\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o em R$"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo ap\u00f3s a transa\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da transa\u00e7\u00e3o"
    },
    "reference_id": {
      "type": "string",
      "description": "ID do servi\u00e7o ou evento relacionado"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "service",
        "cashback",
        "referral",
        "withdrawal",
        "bonus",
        "refund"
      ],
      "description": "Tipo da refer\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "failed",
        "cancelled"
      ],
      "default": "completed"
    },
    "pix_key": {
      "type": "string",
      "description": "Chave PIX usada no saque (se aplic\u00e1vel)"
    }
  },
  "required": [
    "wallet_id",
    "owner_id",
    "type",
    "amount"
  ]
}