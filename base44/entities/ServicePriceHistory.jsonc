{
  "name": "ServicePriceHistory",
  "type": "object",
  "properties": {
    "service_id": {
      "type": "string",
      "description": "ID do servi\u00e7o relacionado"
    },
    "service_number": {
      "type": "string",
      "description": "N\u00famero do servi\u00e7o (desnormalizado)"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "initial_estimate",
        "extra_charges_requested",
        "extra_charges_approved",
        "extra_charges_rejected",
        "extra_charges_negotiated",
        "price_adjustment",
        "final_price_set"
      ],
      "description": "Tipo de altera\u00e7\u00e3o"
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "provider",
        "client",
        "admin"
      ],
      "description": "Quem fez a a\u00e7\u00e3o"
    },
    "actor_name": {
      "type": "string",
      "description": "Nome de quem fez a a\u00e7\u00e3o"
    },
    "previous_price": {
      "type": "number",
      "description": "Valor anterior"
    },
    "new_price": {
      "type": "number",
      "description": "Novo valor"
    },
    "extra_charges_total": {
      "type": "number",
      "description": "Total de extras nesta altera\u00e7\u00e3o"
    },
    "reason": {
      "type": "string",
      "description": "Motivo da altera\u00e7\u00e3o (ex: materiais adicionais, m\u00e3o de obra)"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionais"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "negotiated"
      ],
      "description": "Status da altera\u00e7\u00e3o"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da altera\u00e7\u00e3o"
    }
  },
  "required": [
    "service_id",
    "event_type",
    "actor_type",
    "new_price"
  ]
}