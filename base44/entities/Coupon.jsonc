{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do cupom (ex: SUMMER2024)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do cupom"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "description": "Tipo de desconto: percentual ou valor fixo"
    },
    "discount_value": {
      "type": "number",
      "description": "Valor do desconto (% ou R$)"
    },
    "min_amount": {
      "type": "number",
      "description": "Valor m\u00ednimo do servi\u00e7o para aplicar cupom"
    },
    "max_discount_amount": {
      "type": "number",
      "description": "Desconto m\u00e1ximo em R$ (para descontos percentuais)"
    },
    "max_uses": {
      "type": "number",
      "description": "N\u00famero m\u00e1ximo de usos (null = ilimitado)"
    },
    "current_uses": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero atual de usos"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da validade"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Data final da validade"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o cupom est\u00e1 ativo"
    },
    "service_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de servi\u00e7o aos quais se aplica (vazio = todos)"
    },
    "applicable_to_providers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de prestadores aos quais se aplica (vazio = todos)"
    }
  },
  "required": [
    "code",
    "discount_type",
    "discount_value"
  ]
}