{
  "name": "Ticket",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "client_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "provider_id": {
      "type": "string",
      "description": "ID do prestador (se ticket do prestador)"
    },
    "provider_name": {
      "type": "string",
      "description": "Nome do prestador (se ticket do prestador)"
    },
    "provider_email": {
      "type": "string",
      "description": "Email do prestador (se ticket do prestador)"
    },
    "type": {
      "type": "string",
      "enum": [
        "reclamacao",
        "elogio",
        "sugestao",
        "duvida",
        "problema_tecnico",
        "pagamento",
        "outro"
      ],
      "description": "Tipo do ticket"
    },
    "subject": {
      "type": "string",
      "description": "Assunto do ticket"
    },
    "message": {
      "type": "string",
      "description": "Mensagem do cliente ou prestador"
    },
    "service_request_id": {
      "type": "string",
      "description": "ID do servi\u00e7o relacionado (opcional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_atendimento",
        "resolvido",
        "fechado"
      ],
      "default": "aberto",
      "description": "Status do ticket"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media",
      "description": "Prioridade do ticket"
    },
    "attendant_name": {
      "type": "string",
      "description": "Nome do atendente respons\u00e1vel"
    },
    "attendant_login": {
      "type": "string",
      "description": "Login do atendente"
    },
    "internal_notes": {
      "type": "string",
      "description": "Notas internas do atendente"
    },
    "response": {
      "type": "string",
      "description": "Resposta ao cliente ou prestador"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da resposta"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da resolu\u00e7\u00e3o"
    }
  },
  "required": [
    "type",
    "subject",
    "message"
  ]
}