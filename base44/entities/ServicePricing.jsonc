{
  "name": "ServicePricing",
  "type": "object",
  "properties": {
    "service_type": {
      "type": "string",
      "description": "Tipo de servi\u00e7o (ex: eletrica, hidraulica)"
    },
    "zone": {
      "type": "string",
      "description": "Zona/Bairro (ex: Centro, Zona Sul - deixe em branco para precifica\u00e7\u00e3o padr\u00e3o)"
    },
    "city": {
      "type": "string",
      "description": "Cidade (deixe em branco para precifica\u00e7\u00e3o padr\u00e3o)"
    },
    "state": {
      "type": "string",
      "description": "Estado/UF (deixe em branco para precifica\u00e7\u00e3o padr\u00e3o)"
    },
    "price_min": {
      "type": "number",
      "description": "Pre\u00e7o m\u00ednimo sugerido (o cliente pagar\u00e1)"
    },
    "price_max": {
      "type": "number",
      "description": "Pre\u00e7o m\u00e1ximo sugerido (o cliente pagar\u00e1)"
    },
    "ticket_medio": {
      "type": "number",
      "description": "Ticket m\u00e9dio esperado para este servi\u00e7o (refer\u00eancia para o prestador)"
    },
    "note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre a precifica\u00e7\u00e3o (ex: por ponto, por metro)"
    },
    "repasse_value": {
      "type": "number",
      "description": "Valor fixo de repasse ao prestador (em R$)"
    },
    "repasse_percent": {
      "type": "number",
      "description": "Porcentagem do valor cobrado repassada ao prestador"
    },
    "repasse_percent_ticket": {
      "type": "number",
      "description": "Porcentagem do ticket m\u00e9dio do prestador repassada"
    },
    "repasse_note": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o sobre o repasse"
    }
  },
  "required": [
    "service_type"
  ]
}