{
  "name": "BonusRelease",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia YYYY-MM"
    },
    "goal_id": {
      "type": "string",
      "description": "ID da meta mensal"
    },
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "provider_name": {
      "type": "string",
      "description": "Nome do prestador"
    },
    "rank": {
      "type": "number",
      "description": "Posi\u00e7\u00e3o no ranking (1, 2, 3...)"
    },
    "score": {
      "type": "number",
      "description": "Pontua\u00e7\u00e3o final do prestador"
    },
    "jobs_completed": {
      "type": "number",
      "description": "Servi\u00e7os conclu\u00eddos no m\u00eas"
    },
    "avg_rating": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o m\u00e9dia no m\u00eas"
    },
    "avg_punctuality": {
      "type": "number",
      "description": "Pontualidade m\u00e9dia no m\u00eas"
    },
    "bonus_amount": {
      "type": "number",
      "description": "Valor do b\u00f4nus recebido (R$)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago"
      ],
      "default": "pendente",
      "description": "Status do pagamento do b\u00f4nus"
    }
  },
  "required": [
    "month",
    "provider_id",
    "rank",
    "bonus_amount"
  ]
}