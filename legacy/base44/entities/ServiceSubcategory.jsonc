{
  "name": "ServiceSubcategory",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string",
      "description": "ID da categoria pai"
    },
    "category_name": {
      "type": "string",
      "description": "Nome da categoria pai (desnormalizado)"
    },
    "name": {
      "type": "string",
      "description": "Nome do subt\u00f3pico"
    },
    "icon": {
      "type": "string",
      "description": "Nome do \u00edcone Lucide"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do subt\u00f3pico"
    },
    "estimated_price_min": {
      "type": "number",
      "description": "Pre\u00e7o m\u00ednimo estimado"
    },
    "estimated_price_max": {
      "type": "number",
      "description": "Pre\u00e7o m\u00e1ximo estimado"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativo"
    },
    "order": {
      "type": "number",
      "default": 0,
