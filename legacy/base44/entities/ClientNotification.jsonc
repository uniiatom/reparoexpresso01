{
  "name": "ClientNotification",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_email": {
      "type": "string",
      "description": "Email do cliente (desnormalizado)"
    },
    "type": {
      "type": "string",
      "enum": [
        "terms_update",
        "service_completed",
        "service_accepted",
        "warning",
        "promotion",
        "extra_charges_pending"
      ],
      "description": "Tipo de notifica\u00e7\u00e3o"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da notifica\u00e7\u00e3o"
    },
    "message": {
      "type": "string",
      "description": "Mensagem da notifica\u00e7\u00e3o"
    },
    "service_id": {
      "type": "string",
      "description": "ID do servi\u00e7o relacionado (para extra_charges_pending)"
    },
    "service_number": {
      "type": "string",
      "description": "N\u00famero do servi\u00e7o (desnormalizado)"
    },
    "provider_name": {
      "type": "string",
      "description": "Nome do prestador (desnormalizado)"
    },
    "extra_total": {
      "type": "number",
      "description": "Valor total de extras"
    },
    "new_total": {
      "type": "number",
      "description": "Novo valor total do servi\u00e7o"
    },
    "action_url": {
      "type": "string",
      "description": "URL para a\u00e7\u00e3o (ex: /perfil para ver os termos)"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Se a notifica\u00e7\u00e3o foi lida"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando foi lida"
    }
  },
  "required": [
    "client_id",
    "type",
    "title",
    "message"
  ]
}