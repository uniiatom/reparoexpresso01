{
  "name": "ReserveFundTransaction",
  "type": "object",
  "properties": {
    "reserve_fund_id": {
      "type": "string",
      "description": "ID do fundo de reserva"
    },
    "provider_id": {
      "type": "string",
      "description": "ID do prestador"
    },
    "service_request_id": {
      "type": "string",
      "description": "ID do servi\u00e7o que gerou a transa\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "retencao",
        "debito_indenizacao",
        "liberacao_saida"
      ],
      "description": "Tipo de transa\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o"
    },
    "service_value": {
      "type": "number",
      "description": "Valor total do servi\u00e7o (para reten\u00e7\u00f5es)"
    },
    "retention_percentage": {
      "type": "number",
      "default": 3,
      "description": "Percentual retido (3% padr\u00e3o)"
    },
    "blocked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Data at\u00e9 quando o valor fica bloqueado (reten\u00e7\u00e3o + 3 meses)"
    },
    "reason": {
      "type": "string",
      "description": "Motivo da transa\u00e7\u00e3o (ex: Servi\u00e7o conclu\u00eddo, Indeniza\u00e7\u00e3o por falha)"
    },
    "related_complaint_id": {
      "type": "string",
      "description": "ID da reclama\u00e7\u00e3o que causou d\u00e9bito (se aplic\u00e1vel)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "confirmada",
        "cancelada"
      ],
      "default": "confirmada"
    }
  },
  "required": [
    "provider_id",
    "type",
    "amount"
  ]
}