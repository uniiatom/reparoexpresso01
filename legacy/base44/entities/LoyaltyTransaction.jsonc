{
  "name": "LoyaltyTransaction",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "type": {
      "type": "string",
      "enum": [
        "earned",
        "used",
        "expired",
        "bonus"
      ],
      "description": "Tipo de transa\u00e7\u00e3o"
    },
    "points": {
      "type": "number",
      "description": "Quantidade de pontos"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da transa\u00e7\u00e3o"
    },
    "request_id": {
      "type": "string",
      "description": "ID do servi\u00e7o relacionado (se aplic\u00e1vel)"
    },
    "service_value": {
      "type": "number",
      "description": "Valor do servi\u00e7o que gerou os pontos"
    },
    "balance_after": {
      "type": "number",
      "description": "Saldo de pontos ap\u00f3s a transa\u00e7\u00e3o"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "service_completion",
        "payment",
        "referral",
        "bonus_promotion"
      ],
      "description": "Tipo de refer\u00eancia"
    }
  },
  "required": [
    "client_id",
    "type",
    "points"
  ]
}