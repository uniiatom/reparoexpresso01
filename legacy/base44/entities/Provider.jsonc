{
  "name": "Provider",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio vinculado"
    },
    "name": {
      "type": "string",
      "description": "Nome completo"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "E-mail do prestador"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do prestador"
    },
    "rg": {
      "type": "string",
      "description": "RG / Identidade do prestador"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto de rosto (aprovada)"
    },
    "photo_body_url": {
      "type": "string",
      "description": "Foto de corpo inteiro (aprovada)"
    },
    "photo_url_pending": {
      "type": "string",
      "description": "Foto de rosto aguardando aprova\u00e7\u00e3o"
    },
    "photo_body_url_pending": {
      "type": "string",
      "description": "Foto de corpo inteiro aguardando aprova\u00e7\u00e3o"
    },
    "photos_pending_review": {
      "type": "boolean",
      "default": false,
      "description": "Se h\u00e1 fotos aguardando aprova\u00e7\u00e3o do admin"
    },
    "cnh_url": {
      "type": "string",
      "description": "URL do documento CNH"
    },
    "cnh_expiry": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento da CNH"
    },
    "cnh_status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado"
      ],
      "default": "pendente",
      "description": "Status de aprova\u00e7\u00e3o da CNH"
    },
    "cnh_rejection_reason": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o da CNH"
    },
    "crlv_url": {
      "type": "string",
      "description": "URL do documento CRLV"
    },
    "crlv_expiry": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento do CRLV"
    },
    "crlv_status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado"
      ],
      "default": "pendente",
      "description": "Status de aprova\u00e7\u00e3o do CRLV"
    },
    "crlv_rejection_reason": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o do CRLV"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ do prestador (PJ)"
    },
    "cnpj_url": {
      "type": "string",
      "description": "URL do comprovante de CNPJ"
    },
    "cnpj_status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado",
        "nao_enviado"
      ],
      "default": "nao_enviado",
      "description": "Status de aprova\u00e7\u00e3o do CNPJ"
    },
    "cnpj_rejection_reason": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o do CNPJ"
    },
    "background_check_url": {
      "type": "string",
      "description": "URL do documento de antecedentes criminais"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado",
        "nao_enviado"
      ],
      "default": "nao_enviado",
      "description": "Status de aprova\u00e7\u00e3o dos antecedentes criminais"
    },
    "background_check_rejection_reason": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o dos antecedentes"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Especialidades do prestador"
    },
    "address": {
      "type": "string",
      "description": "Rua e n\u00famero"
    },
    "neighborhood": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string",
      "description": "CEP"
    },
    "bio": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o profissional"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude atual do prestador"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude atual do prestador"
    },
    "is_online": {
      "type": "boolean",
      "default": false,
      "description": "Se est\u00e1 dispon\u00edvel agora"
    },
    "is_approved": {
      "type": "boolean",
      "default": false,
      "description": "Aprovado pelo admin"
    },
    "is_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Se o prestador foi reprovado"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Motivo da reprova\u00e7\u00e3o"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da reprova\u00e7\u00e3o"
    },
    "is_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Se o prestador foi bloqueado"
    },
    "block_reason": {
      "type": "string",
      "description": "Motivo do bloqueio"
    },
    "blocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do bloqueio"
    },
    "is_archived": {
      "type": "boolean",
      "default": false,
      "description": "Se o prestador foi arquivado (reprovado ou bloqueado)"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "total_reviews": {
      "type": "number",
      "default": 0
    },
    "total_jobs": {
      "type": "number",
      "default": 0
    },
    "experience_years": {
      "type": "number"
    },
    "push_subscription": {
      "type": "string",
      "description": "JSON da Web Push subscription do navegador do prestador"
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima aceita\u00e7\u00e3o dos termos"
    }
  },
  "required": [
    "name"
  ]
}