# Copie para .env local ou importe no Netlify com: pnpm netlify:env
# (somente variáveis VITE_* vão para o bundle do navegador)

# Base44 — backend legado
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=

# Supabase — Reparo Expresso
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Opcional
# VITE_SUPABASE_STORAGE_BUCKET=uploads
# VITE_VAPID_PUBLIC_KEY=

# NÃO use prefixo VITE_ em tokens secretos (ex: SUPABASE_ACCESS_TOKEN — só CLI local)

# Supabase Auth após deploy:
# Site URL: https://SEU-SITE.netlify.app
# Redirect URLs: https://SEU-SITE.netlify.app/**
